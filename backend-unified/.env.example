# Medical AI Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# ============================================
# Database Configuration
# ============================================
# SQLite (Development)
DATABASE_URL=sqlite:///./medical_ai.db

# PostgreSQL (Production) - Uncomment to use
# DATABASE_URL=postgresql://username:password@localhost:5432/medical_ai

# ============================================
# JWT Authentication (CRITICAL - CHANGE IN PRODUCTION)
# ============================================
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2024-USE-SECURE-RANDOM-KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60

# ============================================
# ML Configuration
# ============================================
ML_ENABLED=True
ML_MODEL_PATH=./models

# ============================================
# LLM Configuration (phi-3-mini)
# ============================================
LLM_ENABLED=True
LLM_MODEL_PATH=./models/phi-3-mini-4k-instruct-q4.gguf
LLM_MAX_TOKENS=512
LLM_N_CTX=2048
MAX_RAM_USAGE_GB=6.5
USE_GPU=False  # Set to True if you have CUDA GPU

# ============================================
# RAG Configuration
# ============================================
RAG_ENABLED=True
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=3

# ============================================
# Redis (Optional - for caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Vision Service Configuration
# ============================================
VISION_ENABLED=True
VISION_MODEL_PATH=./models/vision
USE_GPU_VISION=False

# ============================================
# Security (Production)
# ============================================
# Set to True in production to force HTTPS
ENFORCE_HTTPS=False
# HSTS max-age in seconds (1 year)
HSTS_MAX_AGE=31536000
